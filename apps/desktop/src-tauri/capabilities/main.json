{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Only the bundled main workbench may call the constrained native commands.",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "allow-desktop-status",
    "allow-api-request",
    "allow-api-cancel",
    "allow-reset-session",
    "allow-save-download",
    "allow-open-external",
    "allow-offline-status",
    "allow-offline-list",
    "allow-offline-install",
    "allow-offline-search",
    "allow-offline-read",
    "allow-offline-remove",
    "allow-offline-unlock-previous-owner",
    "allow-offline-fallback-decide",
    "allow-offline-fallback-consume",
    "allow-offline-fallback-revoke",
    "allow-offline-fallback-status",
    "allow-offline-fallback-authority-refresh",
    "allow-offline-fallback-policy-preview",
    "allow-offline-fallback-policy-apply",
    "allow-offline-fallback-policy-pause",
    "allow-offline-fallback-policy-revoke",
    "allow-offline-fallback-authorize",
    "allow-offline-sync-status",
    "allow-offline-sync-preview",
    "allow-offline-sync-apply",
    "allow-offline-sync-pause",
    "allow-offline-sync-revoke",
    "allow-offline-sync-run",
    "allow-offline-sync-revalidate",
    "allow-device-ai-prepare",
    "allow-device-ai-submit-stream",
    "allow-device-ai-lookup-attempt",
    "allow-device-ai-read-journal",
    "allow-device-ai-journal-append",
    "allow-device-ai-resolve-unknown"
  ]
}
