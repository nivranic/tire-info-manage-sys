};
const QUESTION = "P225 这条轮胎的历史参数如何解析？";
const SOURCE_JSON = '{"source_id":"src-1","observed_at":"2026-01-01T00:00:00Z","verified_at":null,"verification_id":"ver-1","load_index_9007199254740993":9007199254740993,"pressure":0.1000000000000000001,"negative_zero":-0}';

// ===========================================================================
export async function main(): Promise<void> {
  await sectionA();
  sectionB();
  await sectionC();
  await sectionD();
  await sectionE();
  await sectionF();
  await sectionG();
