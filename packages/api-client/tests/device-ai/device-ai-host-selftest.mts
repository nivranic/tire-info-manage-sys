  const vehicleCase = loadVectorCase("empty-vehicle-complete");
  await throwsPortAsync("E27 mode/kind mismatch (vehicle under single_observation)", () => computeLocalPreview(vehicleCase.bytes, {
    question: QUESTION, selectors: vehicleCase.input.selectors, origin: vectorOrigin(vehicleCase.input), projectionMode: "single_observation",
  }), "device_ai_projection_mode_unsupported");
  await throwsHostAsync("E28 unknown mode string rejected", () => computeLocalPreview(single.bytes, {
    question: QUESTION, selectors: single.input.selectors, origin: singleOrigin, projectionMode: "bogus" as DeviceAiProjectionMode,
  }), "device_ai_host_preview_unsupported");
}

// ---------------------------------------------------------------------------
// F. Journal: append / verify / tamper / five fences.
// ---------------------------------------------------------------------------
class MemoryStore implements DeviceAiJournalStore {
  blob: Uint8Array | null = null;
  async load(): Promise<Uint8Array | null> { return this.blob ? this.blob.slice() : null; }
  async save(blob: Uint8Array): Promise<void> { this.blob = blob.slice(); }
}

const jAad = (owner: string): Uint8Array => new TextEncoder().encode(JSON.stringify(["device-ai-journal@1", owner]));
async function unsealForTest(blob: Uint8Array, key: CryptoKey): Promise<{ wire: { schema: string; owner: string; generation: number; iv_hex: string; ciphertext_base64: string }; entries: unknown[] }> {
  const wire = JSON.parse(new TextDecoder().decode(blob)) as { iv_hex: string; ciphertext_base64: string };
  const iv = Uint8Array.from(wire.iv_hex.match(/../g)!, hex => Number.parseInt(hex, 16));
  const ciphertext = Uint8Array.from(atob(wire.ciphertext_base64), char => char.charCodeAt(0));
  const plaintext = new Uint8Array(await globalThis.crypto.subtle.decrypt({ name: "AES-GCM", iv, additionalData: jAad(wire.owner) }, key, ciphertext));
  return { wire: wire as never, entries: (JSON.parse(new TextDecoder().decode(plaintext)) as { entries: unknown[] }).entries };
}
async function resealForTest(wire: { schema: string; owner: string; generation: number; iv_hex: string; ciphertext_base64: string }, entries: unknown[], key: CryptoKey): Promise<Uint8Array> {
  const iv = globalThis.crypto.getRandomValues(new Uint8Array(12));
  const plaintext = new TextEncoder().encode(JSON.stringify({ entries }));
  const ciphertext = await globalThis.crypto.subtle.encrypt({ name: "AES-GCM", iv, additionalData: jAad(wire.owner) }, key, plaintext);
  return new TextEncoder().encode(JSON.stringify({ ...wire, iv_hex: Array.from(iv, b => b.toString(16).padStart(2, "0")).join(""), ciphertext_base64: btoa(String.fromCharCode(...new Uint8Array(ciphertext))) }));
}

async function sectionF(): Promise<void> {
  section("F. journal append / verify / tamper / five fences");
  const key = await globalThis.crypto.subtle.generateKey({ name: "AES-GCM", length: 256 }, false, ["encrypt", "decrypt"]);
  const otherKey = await globalThis.crypto.subtle.generateKey({ name: "AES-GCM", length: 256 }, false, ["encrypt", "decrypt"]);
  const store = new MemoryStore();
  let clock = 0;
  const journal = new DeviceAiJournal({
    owner: "profile-1", generation: 1, sessionId: "session-1", key, store,
    monotonicNow: () => clock += 10, wallNow: () => "2026-10-02T00:00:00Z",
  });

  const empty = await journal.verifyIntegrity();
  ok("F1 empty journal verifies", empty.ok && empty.length === 0);

  const e1 = await journal.append({ type: "preview_shown", intent_id: "i-1", local_preview_fingerprint: "aa".repeat(32), question_sha256: "bb".repeat(32), package_sha256: "cc".repeat(32) });
  const e2 = await journal.append({ type: "decision_made", intent_id: "i-1", decision: "allow", local_preview_fingerprint: "aa".repeat(32) });
  const e3 = await journal.append({ type: "claim_submitted", intent_id: "i-1", prepare_id: "prep-1", analysis_key: "11111111-2222-4333-8444-555555555555", question_sha256: "bb".repeat(32) });
  eq("F2 sequence numbering", [e1.sequence, e2.sequence, e3.sequence], [1, 2, 3]);
  ok("F3 genesis prev", e1.prev_sha256 === "0".repeat(64));
  ok("F4 chained prev", e2.prev_sha256 === e1.entry_sha256 && e3.prev_sha256 === e2.entry_sha256);
  ok("F5 owner/generation/session stamped", e3.owner === "profile-1" && e3.generation === 1 && e3.session_id === "session-1");
  ok("F6 monotonic clock stamped", e1.clock === 10 && e2.clock === 20 && e3.clock === 30);

  const readBack = await journal.readAll();
  eq("F7 readAll preserves entries", readBack.length, 3);
  readBack[0].event.type = "failure_observed"; // mutate the returned copy only
  const again = await journal.readAll();
  eq("F8 readAll returns clones (stored copy untouched)", again[0].event.type, "preview_shown");

  const verified = await journal.verifyIntegrity();
  ok("F10 intact journal verifies clean", verified.ok && verified.length === 3 && verified.cross_session_entries.length === 0);

  // Fence 3 — tamper with entry content (entry_sha256 kept stale).
  {
    const { wire, entries } = await unsealForTest(store.blob!, key);
    (entries[1] as { event: { decision: string } }).event.decision = "deny";
    store.blob = await resealForTest(wire, entries, key);
    const tampered = await journal.verifyIntegrity();
    ok("F11 tampered entry detected (SHA fence)", !tampered.ok && tampered.violations.some(v => v.code === "device_ai_host_journal_entry_tampered" && v.sequence === 2));
    await throwsHostAsync("F12 readAll rejects tampered chain", () => journal.readAll(), "device_ai_host_journal_entry_tampered");
    (entries[1] as { event: { decision: string } }).event.decision = "allow";
    store.blob = await resealForTest(wire, entries, key);
    ok("F13 restored journal verifies again", (await journal.verifyIntegrity()).ok);
  }

  // Fence 3 — break the chain link.
  {
    const { wire, entries } = await unsealForTest(store.blob!, key);
    (entries[2] as { prev_sha256: string }).prev_sha256 = "ee".repeat(32);
    store.blob = await resealForTest(wire, entries, key);
    const broken = await journal.verifyIntegrity();
    ok("F14 broken chain detected", !broken.ok && broken.violations.some(v => v.code === "device_ai_host_journal_chain_broken" && v.sequence === 3));
    (entries[2] as { prev_sha256: string }).prev_sha256 = (entries[1] as { entry_sha256: string }).entry_sha256;
    store.blob = await resealForTest(wire, entries, key);
  }

  // Fence 4 — clock regression at write time.
  clock = 5;
  await throwsHostAsync("F15 append with regressed clock rejected", () => journal.append({ type: "failure_observed", intent_id: "i-1", stage: "submit", code: "api_network_unavailable" }), "device_ai_host_journal_clock_regression");
  clock = 40;
  const e4 = await journal.append({ type: "failure_observed", intent_id: "i-1", stage: "submit", code: "api_network_unavailable" });
  eq("F16 append resumes after clock restored", e4.sequence, 4);

  // Fence 4 — reordered entries (older clock appended after newer) detected on read.
  {
    const { wire, entries } = await unsealForTest(store.blob!, key);
    const reordered = [...entries];
    const last = reordered.pop()!;
    reordered.unshift(last); // sequence 4 (clock 40) before sequence 1 (clock 10)
    store.blob = await resealForTest(wire, reordered, key);
    const check = await journal.verifyIntegrity();
    ok("F17 clock regression in stored order detected", !check.ok && check.violations.some(v => v.code === "device_ai_host_journal_clock_regression"));
    store.blob = await resealForTest(wire, entries, key);
  }

  // Fence 1 — wrong owner.
  const wrongOwner = new DeviceAiJournal({ owner: "profile-2", generation: 1, sessionId: "session-1", key, store, monotonicNow: () => clock += 10 });
  const ownerCheck = await wrongOwner.verifyIntegrity();
  ok("F18 owner fence (header + AAD)", !ownerCheck.ok && ownerCheck.violations[0]?.code === "device_ai_host_journal_owner_mismatch");
  await throwsHostAsync("F19 readAll under wrong owner rejected", () => wrongOwner.readAll(), "device_ai_host_journal_owner_mismatch");

  // Fence 2 — stale generation after a rebuild.
  const staleGeneration = new DeviceAiJournal({ owner: "profile-1", generation: 2, sessionId: "session-1", key, store, monotonicNow: () => clock += 10 });
  const generationCheck = await staleGeneration.verifyIntegrity();
  ok("F20 generation fence voids old blob", !generationCheck.ok && generationCheck.violations[0]?.code === "device_ai_host_journal_generation_mismatch");

  // Wrong key: AES-GCM AAD/authentication fails => corrupt.
  const wrongKey = new DeviceAiJournal({ owner: "profile-1", generation: 1, sessionId: "session-1", key: otherKey, store, monotonicNow: () => clock += 10 });
  const keyCheck = await wrongKey.verifyIntegrity();
  ok("F21 wrong key fails decryption (corrupt)", !keyCheck.ok && keyCheck.violations[0]?.code === "device_ai_host_journal_corrupt");

  // Fence 5 — session binding.
  const nextSession = new DeviceAiJournal({ owner: "profile-1", generation: 1, sessionId: "session-2", key, store, monotonicNow: () => clock += 10 });
  const cross = await nextSession.verifyIntegrity();
  ok("F22 recovery read allowed across sessions (structure ok)", cross.ok);
  eq("F23 cross-session entries recorded", cross.cross_session_entries.length, 4);
  const freshEntries = await nextSession.readAll();
  throwsHost("F24 assertSameSession on real cross-session entries", () => nextSession.assertSameSession(freshEntries), "device_ai_host_journal_session_mismatch");
  const appended = await nextSession.append({ type: "failure_observed", intent_id: null, stage: "recover", code: "none" });
  eq("F25 new entries stamp the current session", appended.session_id, "session-2");
}

