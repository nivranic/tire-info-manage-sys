// ---------------------------------------------------------------------------
// A. Server DTO field parity.
// ---------------------------------------------------------------------------
async function sectionA(): Promise<void> {
  section("A. server DTO field parity");
  // Manually transcribed from apps/api/tire_api/device_ai.py (DeviceAIPrepareRequest,
  // DeviceSubmission, ProviderConsent) and ai_analysis.py (AnalysisRequest).
  const serverPrepare = ["package_id", "expected_sha256", "expected_byte_count", "expected_schema",
    "expected_owner_scope_id", "selectors", "projection_mode", "approved_closure",
    "expected_projection_sha256", "question_sha256", "host_receipt_id", "intent_id"];
  const serverSubmission = ["prepare_id", "host_receipt_id", "device_context_fingerprint", "provider_consent"];
  const serverConsent = ["expected_pack_fingerprint", "expected_device_context_fingerprint", "question_sha256",
    "provider", "model", "expected_provider_policy_fingerprint"];
  const serverAnalysis = ["pack_id", "question", "allow_external_processing", "device_submission"];
  eq("A1 prepare fields == server DeviceAIPrepareRequest", [...DEVICE_AI_PREPARE_REQUEST_FIELDS], serverPrepare);
  eq("A2 submission fields == server DeviceSubmission", [...DEVICE_AI_SUBMISSION_FIELDS], serverSubmission);
  eq("A3 consent fields == server ProviderConsent", [...DEVICE_AI_PROVIDER_CONSENT_FIELDS], serverConsent);
  eq("A4 analysis fields == server AnalysisRequest", [...DEVICE_AI_ANALYSIS_REQUEST_FIELDS], serverAnalysis);

  const validPrepare = {
    package_id: "pkg-1", expected_sha256: "ef".repeat(32), expected_byte_count: 1234,
    expected_schema: "offline-pack@2" as const, expected_owner_scope_id: "9a".repeat(32),
    selectors: [selA], projection_mode: "single_observation" as const, approved_closure: null,
    expected_projection_sha256: "99".repeat(32), question_sha256: "01".repeat(32),
    host_receipt_id: "11111111-2222-4333-8444-555555555555",
    intent_id: "11111111-2222-4333-8444-555555555555",
  };
  assertDeviceAiPrepareBody(validPrepare);
  ok("A5 valid prepare body passes closed assertion", true);
  throwsClosed("A6 extra field rejected (server extra=forbid would 422)", () => assertDeviceAiPrepareBody({ ...validPrepare, local_preview_fingerprint: "x".repeat(64) } as never));
  const missing = { ...validPrepare } as Partial<typeof validPrepare>;
  delete missing.question_sha256;
  throwsClosed("A7 missing required field rejected", () => assertDeviceAiPrepareBody(missing as never));
  // M6 (decoder-spec section 3): UUID negative family — non-UUID shapes and
  // non-canonical spellings (no-hyphen / version 0 / variant c) fail closed;
  // the uppercase/braced positives live in G3/H1.
  for (const bad of ["not-a-uuid", "9999aaaa0bbbb0cccc0dddd055555eee66666",
    "9999aaaa-bbbb-0ccc-8ddd-5555eee66666", "9999aaaa-bbbb-4ccc-cddd-5555eee66666",
    "9999aaaa bbbb 4ccc 8ddd 5555eee66666"]) {
    throwsHost(`A8 non-canonical UUID rejected (${bad.slice(0, 16)}…)`, () => canonicalDeviceAiUuid(bad), "device_ai_host_invalid_argument");
  }
}

// ---------------------------------------------------------------------------
// B. question trim-once + bare sha256 parity (Python reference digests).
// ---------------------------------------------------------------------------
function sectionB(): void {
  section("B. question trim-once + sha256 parity");
  eq("B1 strip both ends once", trimOnceQuestion("  历史问题  "), "历史问题");
  eq("B2 U+3000 and U+000B are whitespace (Python set)", trimOnceQuestion("　历史问题\v"), "历史问题");
  eq("B3 internal whitespace preserved", trimOnceQuestion("问题  内容"), "问题  内容");
  eq("B4 whole leading/trailing run stripped in one pass", trimOnceQuestion("   问题   内容   "), "问题   内容");
  // Pinned whitespace set evidence: U+001C IS Python whitespace (JS trim would
  // strip it too only in some engines; U+FEFF is NOT Python whitespace — a
  // naive String.prototype.trim() would strip it and break parity).
  eq("B5 U+001C stripped (Python set, beyond JS trim)", trimOnceQuestion("\x1c问题\x1c"), "问题");
  eq("B6 U+FEFF kept (not in Python set, differs from JS trim)", trimOnceQuestion("\ufeff问题"), "\ufeff问题");
  eq("B7 normalize passes codepoint min", normalizeQuestion("ab"), "ab");
  throwsHost("B8 one codepoint rejected", () => normalizeQuestion("a"), "device_ai_host_invalid_argument");
  eq("B9 2000 non-BMP codepoints pass (codepoint counting)", normalizeQuestion("𐀀".repeat(2000)), "𐀀".repeat(2000));
  throwsHost("B10 2001 codepoints rejected", () => normalizeQuestion("𐀀".repeat(2001)), "device_ai_host_invalid_argument");
  // UTF-16 vs codepoint: 2000 surrogate pairs are 4000 UTF-16 units.
  throwsHost("B11 1001 non-BMP pairs (2002 codepoints) rejected", () => normalizeQuestion("𐀀𐀀".repeat(1001)), "device_ai_host_invalid_argument");
}

// ---------------------------------------------------------------------------
// C. fingerprint parity (async).
// ---------------------------------------------------------------------------
async function sectionC(): Promise<void> {
  section("C. fingerprint parity vs Python reference");
  for (const [text, digest] of Object.entries(EXPECTED.question_sha256)) {
    const actual = await questionSha256(text);
    eq(`C-q ${text.slice(0, 12)}…`, actual, digest);
  }
  // NFKC must not be applied; lookalike and fullwidth pairs must differ.
  ok("C1 ligature digests differ (no NFKC)", (await questionSha256("ﬃ 轮胎历史")) !== (await questionSha256("ffi 轮胎历史")));
  ok("C2 fullwidth digests differ (no NFKC)", (await questionSha256("２０００ 年")) !== (await questionSha256("2000 年")));
  ok("C3 no JSON quoting wrapper", (await questionSha256("text")) !== (await questionSha256('"text"')));

  // selection_sha256: request order (B first) must not matter — spec sorts by member_key.
  eq("C4 selection_sha256 unordered == Python", await selectionSha256([selB, selA]), EXPECTED.selection_sha256);
  eq("C5 selection_sha256 ordered == Python", await selectionSha256([selA, selB]), EXPECTED.selection_sha256);
  await throwsHostAsync("C6 duplicate member_key rejected", () => selectionSha256([selA, selA]), "device_ai_host_invalid_argument");

  // device_context_fingerprint: numeric lexemes preserved through the AST.
  const contextHash = await deviceContextFingerprint({
    package_id: "pkg-1", package_schema: "offline-pack@2", package_sha256: "ef".repeat(32),
    projection_mode: "single_observation", projection_sha256: "99".repeat(32), selection_sha256: "01".repeat(32),
    receipt_sources: [{ selector: selA, selection_reason: "requested", source: parseDeviceAiJson(new TextEncoder().encode(SOURCE_JSON)) }],
    device_citations: [], domain_boundaries: [],
  });
  eq("C7 device_context_fingerprint == Python (lexemes 9007199254740993 / 0.1000000000000000001 / -0)", contextHash, EXPECTED.device_context_fingerprint);

  const previewHash = await localPreviewFingerprint({
    questionSha256Value: await questionSha256(QUESTION), includeContextIds: [],
    projectionMode: "single_observation", queryContext: null, origin: ORIGIN,
    selected: [selB], resolvedClosure: [selA], state: "ready", projectionSha256Value: null,
  });
  eq("C8 local_preview_fingerprint == Python", previewHash, EXPECTED.local_preview_fingerprint);
  const blockedHash = await localPreviewFingerprint({
    questionSha256Value: await questionSha256(QUESTION), includeContextIds: [],
    projectionMode: "single_observation", queryContext: null, origin: ORIGIN,
    selected: [selB], resolvedClosure: [selA], state: "blocked", projectionSha256Value: null,
  });
  ok("C9 blocked vs ready differ (state stays in the input)", blockedHash !== previewHash);
  // M4 (decoder-spec section 3): include_context_ids must stay EMPTY until the
  // frozen wire opens the archive-id intent channel; non-empty fails closed
  // before entering the fingerprint AST (computeLocalPreview routes through
  // the same gate).
  const questionHash = await questionSha256(QUESTION);
  await throwsHostAsync("C10 include_context_ids non-empty rejected (must be empty)", () => localPreviewFingerprint({
    questionSha256Value: questionHash, includeContextIds: ["archive-1"],
    projectionMode: "single_observation", queryContext: null, origin: ORIGIN,
    selected: [selB], resolvedClosure: [selA], state: "ready", projectionSha256Value: null,
  }), "device_ai_host_invalid_argument");
}

// ---------------------------------------------------------------------------
// D. device-ai-exact regression anchors from the frozen E1 vectors.
// ---------------------------------------------------------------------------
async function sectionD(): Promise<void> {
  section("D. E1 vector regression anchors");
  const anchors = ["scalar_top_text", "sample_token_9007199254740993", "sample_token_0_1000000000000000001", "escape_chinese_keys_and_text"];
  for (const id of anchors) {
    const vector = E1.vectors.find(item => item.id === id);
    if (!vector || vector.state !== "accepted" || !vector.sha256) { ok(`D ${id} present`, false, "vector missing"); continue; }
    const ast = parseDeviceAiJson(new TextEncoder().encode(vector.input.text!));
    eq(`D ${id}`, await deviceAiDigest(ast), vector.sha256);
  }
}

// ---------------------------------------------------------------------------
// E. computeLocalPreview over the SEALED projection vectors (P1-4b): four
// domains + frozen_decision_closure, projection re-computed on-device.
// ---------------------------------------------------------------------------
// The sealed vector corpus stays in .artifacts (read-only evidence); from the
// repo copy that is four levels up from this directory.
const VECTORS_DIR = HERE + "../../../../.artifacts/device-ai50/projection-vectors-a/";
const VECTOR_MANIFEST = JSON.parse(readFileSync(VECTORS_DIR + "manifest.json", "utf8")) as {
  source_core: { sha256: string };
  domain_vectors: { case: string; state: string; member_count?: number; input: { path: string }; expectation: { path: string } }[];
};
const PACKS_BY_SHA = new Map<string, Uint8Array>();
for (const name of ["legacy-pack.json", "nonempty-pack.json", "empty-pack.json"]) {
  const raw = new Uint8Array(readFileSync(VECTORS_DIR + "inputs/" + name));
  PACKS_BY_SHA.set(createHash("sha256").update(raw).digest("hex"), raw);
}
const sha256Hex = (bytes: Uint8Array): string => createHash("sha256").update(bytes).digest("hex");
const HASH64_RE = /^[0-9a-f]{64}$/;

interface LoadedCase {
  vector: { case: string; state: string; member_count?: number; input: { path: string }; expectation: { path: string } };
  input: {
    mode: DeviceAiProjectionMode;
    approved_closure: DeviceAiSelectorWire[] | null;
    binding: { package_id: string; owner_scope_id: string; sha256: string; byte_count: number; schema: "offline-pack@1" | "offline-pack@2" };
    selectors: DeviceAiSelectorWire[];
    max_projection_bytes: number;
    core_sha256: string;
  };
  expectation: { canonical_projection: { sha256: string; byte_count: number } | null; expected_error_code: string | null };
  bytes: Uint8Array;
}
function loadVectorCase(name: string): LoadedCase {
  const vector = VECTOR_MANIFEST.domain_vectors.find(item => item.case === name);
  if (!vector) throw new Error(`sealed vector missing: ${name}`);
  const input = JSON.parse(readFileSync(VECTORS_DIR + vector.input.path, "utf8")) as LoadedCase["input"];
  const expectation = JSON.parse(readFileSync(VECTORS_DIR + vector.expectation.path, "utf8")) as LoadedCase["expectation"];
  if (input.core_sha256 !== VECTOR_MANIFEST.source_core.sha256) throw new Error(`core sha drift on ${name}`);
  const bytes = PACKS_BY_SHA.get(input.binding.sha256);
  if (!bytes || bytes.byteLength !== input.binding.byte_count || sha256Hex(bytes) !== input.binding.sha256) {
    throw new Error(`sealed pack missing for ${name}`);
  }
  return { vector, input, expectation, bytes };
}
function vectorOrigin(input: LoadedCase["input"]): DeviceAiOriginBindingWire {
  return {
    expected_profile_id: ORIGIN.expected_profile_id, expected_owner_epoch: ORIGIN.expected_owner_epoch,
    slot_id: ORIGIN.slot_id, expected_generation: ORIGIN.expected_generation,
    package_id: input.binding.package_id, expected_sha256: input.binding.sha256,
    expected_byte_count: input.binding.byte_count, owner_scope_id: input.binding.owner_scope_id,
    package_schema: input.binding.schema,
  };
}

async function sectionE(): Promise<void> {
  section("E. computeLocalPreview over sealed vectors");

  // --- tire single_observation: the phase-A path, now with recomputed projection.
  const single = loadVectorCase("empty-tire-single");
  const singleOrigin = vectorOrigin(single.input);
  const summary = await computeLocalPreview(single.bytes, { question: `  ${QUESTION}  `, selectors: single.input.selectors, origin: singleOrigin });
  eq("E1 located member == sealed selector", summary.located_member_keys, single.input.selectors.map(item => item.member_key));
  eq("E2 package byte count", summary.package_byte_count, single.bytes.byteLength);
  eq("E3 package schema", summary.package_schema, single.input.binding.schema);
  eq("E4 question_sha256 (trim-once inside)", summary.question_sha256, EXPECTED.question_sha256[QUESTION]);
  eq("E5 selection_sha256 == SDK helper over requested closure", summary.selection_sha256, await selectionSha256(single.input.selectors));
  eq("E6 projection_binding recomputed (P1-4b)", summary.projection_binding, "recomputed");
  eq("E7 projection_sha256 == sealed canonical vector", summary.projection_sha256, single.expectation.canonical_projection!.sha256);
  eq("E8 projection byte count == sealed", summary.projection_byte_count, single.expectation.canonical_projection!.byte_count);
  eq("E9 resolved closure == requested (single mode)", summary.resolved_closure_member_keys, single.input.selectors.map(item => item.member_key));
  ok("E10 device_context_fingerprint is a local digest", HASH64_RE.test(summary.device_context_fingerprint));
  eq("E11 preview fingerprint self-consistent (recomputed sha inside, state ready)", summary.local_preview_fingerprint, await localPreviewFingerprint({
    questionSha256Value: await questionSha256(QUESTION), includeContextIds: [], projectionMode: "single_observation",
    queryContext: null, origin: singleOrigin, selected: single.input.selectors,
    resolvedClosure: single.input.selectors, state: "ready", projectionSha256Value: summary.projection_sha256,
  }));

  // --- frozen_decision_closure: no expansion in this vector + consent gate.
  const closure = loadVectorCase("empty-tire-closure");
  const closureSummary = await computeLocalPreview(closure.bytes, {
    question: QUESTION, selectors: closure.input.selectors, origin: vectorOrigin(closure.input), projectionMode: "frozen_decision_closure",
  });
  eq("E12 closure projection_sha256 == sealed vector", closureSummary.projection_sha256, closure.expectation.canonical_projection!.sha256);
  eq("E13 closure resolved closure member keys", closureSummary.resolved_closure_member_keys, closure.input.selectors.map(item => item.member_key));
  // An exact approved closure is accepted and changes nothing (core L744-749).
  const consented = await computeLocalPreview(closure.bytes, {
    question: QUESTION, selectors: closure.input.selectors, origin: vectorOrigin(closure.input),
    projectionMode: "frozen_decision_closure", approvedClosure: closure.input.selectors,
  });
  eq("E14 matching approved_closure accepted, same projection", consented.projection_sha256, closure.expectation.canonical_projection!.sha256);
  await throwsPortAsync("E15 empty approved_closure rejected (consent gate)", () => computeLocalPreview(closure.bytes, {
    question: QUESTION, selectors: closure.input.selectors, origin: vectorOrigin(closure.input),
    projectionMode: "frozen_decision_closure", approvedClosure: [],
  }), "device_ai_closure_consent_required");

  // --- vehicle / recall / recall_search domain dispatch, each anchored to its
  //     sealed canonical projection sha.
  for (const [name, mode] of [
    ["empty-vehicle-complete", "complete_observation"],
    ["empty-formal-recall-nonempty", "complete_formal_observation"],
    ["empty-formal-recall-empty", "complete_formal_observation"],
    ["empty-recall-search-empty", "candidate_page_context"],
  ] as const) {
    const domain = loadVectorCase(name);
    const domainSummary = await computeLocalPreview(domain.bytes, {
      question: QUESTION, selectors: domain.input.selectors, origin: vectorOrigin(domain.input), projectionMode: mode,
    });
    eq(`E16 ${name} projection_sha256 == sealed`, domainSummary.projection_sha256, domain.expectation.canonical_projection!.sha256);
    eq(`E17 ${name} projection_mode echoed`, domainSummary.projection_mode, mode);
    ok(`E18 ${name} context fingerprint differs from tire case`, domainSummary.device_context_fingerprint !== summary.device_context_fingerprint);
  }

  // --- test_event stays rejection-only, with the server's closed code.
  const restricted = loadVectorCase("empty-test-event-restricted");
  await throwsPortAsync("E19 test_event rejected device_ai_selected_restricted", () => computeLocalPreview(restricted.bytes, {
    question: QUESTION, selectors: restricted.input.selectors, origin: vectorOrigin(restricted.input), projectionMode: "complete_event_context",
  }), "device_ai_selected_restricted");

  // --- fail-closed paths (host fences first, then authoritative port codes).
  await throwsHostAsync("E20 sha mismatch fails closed", () => computeLocalPreview(single.bytes, {
    question: QUESTION, selectors: single.input.selectors, origin: { ...singleOrigin, expected_sha256: "ff".repeat(32) },
  }), "device_ai_host_package_mismatch");
  await throwsHostAsync("E21 byte count mismatch fails closed", () => computeLocalPreview(single.bytes, {
    question: QUESTION, selectors: single.input.selectors, origin: { ...singleOrigin, expected_byte_count: single.bytes.byteLength + 1 },
  }), "device_ai_host_package_mismatch");
  await throwsPortAsync("E22 unknown member -> authoritative port code", () => computeLocalPreview(single.bytes, {
    question: QUESTION, selectors: [{ ...single.input.selectors[0], member_key: "ee".repeat(32) }], origin: singleOrigin,
  }), "device_ai_member_missing");
  const foreignRef = { ...single.input.selectors[0], reference: { ...single.input.selectors[0].reference, snapshot_id: "00000000-0000-4000-8000-000000000000" } };
  await throwsPortAsync("E23 reference mismatch -> authoritative port code", () => computeLocalPreview(single.bytes, {
    question: QUESTION, selectors: [foreignRef as DeviceAiSelectorWire], origin: singleOrigin,
  }), "device_ai_receipt_mismatch");
  await throwsPortAsync("E24 duplicate selector rejected", () => computeLocalPreview(single.bytes, {
    question: QUESTION, selectors: [...single.input.selectors, ...single.input.selectors], origin: singleOrigin,
  }), "device_ai_selector_ambiguous");
  await throwsHostAsync("E25 empty selector list rejected", () => computeLocalPreview(single.bytes, {
    question: QUESTION, selectors: [], origin: singleOrigin,
