  DeviceAiHostError,
  assertDeviceAiPrepareBody,
  assertDeviceAiPrepareSelector,
  buildDeviceAiPrepareBody,
  canonicalDeviceAiUuid,
  computeLocalPreview,
  deviceContextFingerprint,
  localPreviewFingerprint,
  normalizeQuestion,
  questionSha256,
  selectionSha256,
  trimOnceQuestion,
  resolveUnknownOutcome,
  DeviceAiHostClient,
  DeviceAiJournal,
  DEVICE_AI_PREPARE_REQUEST_FIELDS,
  DEVICE_AI_SUBMISSION_FIELDS,
  DEVICE_AI_PROVIDER_CONSENT_FIELDS,
  DEVICE_AI_ANALYSIS_REQUEST_FIELDS,
  type DeviceAiJournalStore,
  type DeviceAiPrepareSelectorWire,
  type DeviceAiSelectorWire,
  type DeviceAiOriginBindingWire,
  type DeviceAiProviderConsentBody,
} from "../../src/device-ai-host.ts";
import { deviceAiDigest, parseDeviceAiJson } from "../../src/device-ai-exact.ts";
import { DeviceAiProjectionPortError, type DeviceAiProjectionMode } from "../../src/device-ai-projection.ts";

const HERE = fileURLToPath(new URL(".", import.meta.url));
const EXPECTED = JSON.parse(readFileSync(HERE + "host-expected-fingerprints.json", "utf8")) as {
  question_sha256: Record<string, string>;
  selection_sha256: string;
  device_context_fingerprint: string;
  local_preview_fingerprint: string;
};
const E1 = JSON.parse(readFileSync(HERE + "../../../../.artifacts/device-ai50/specs/e1-canonical-vectors-a.json", "utf8")) as {
  vectors: { id: string; input: { form: string; text?: string }; state: string; sha256?: string }[];
};

let passed = 0;
const failures: string[] = [];
const section = (name: string) => console.log(`\n== ${name} ==`);
const ok = (name: string, condition: boolean, detail = "") => {
  if (condition) { passed++; console.log(`  PASS ${name}`); }
  else { failures.push(`${name}${detail ? ` — ${detail}` : ""}`); console.log(`  FAIL ${name}${detail ? ` — ${detail}` : ""}`); }
};
const eq = (name: string, actual: unknown, expected: unknown) =>
  ok(name, JSON.stringify(actual) === JSON.stringify(expected), `actual=${JSON.stringify(actual)} expected=${JSON.stringify(expected)}`);
const throwsHost = (name: string, fn: () => unknown, code: string) => {
  try { fn(); ok(name, false, "no throw"); }
  catch (error) { ok(name, error instanceof DeviceAiHostError && error.code === code, `code=${(error as { code?: string }).code}`); }
};
/** Closed-field assertions fail as plain programming Errors (not fence codes). */
const throwsClosed = (name: string, fn: () => unknown) => {
  try { fn(); ok(name, false, "no throw"); }
  catch (error) { ok(name, error instanceof Error && /closed DTO/.test(error.message), String(error)); }
};
const throwsHostAsync = async (name: string, fn: () => Promise<unknown>, code: string) => {
  try { await fn(); ok(name, false, "no throw"); }
  catch (error) { ok(name, error instanceof DeviceAiHostError && error.code === code, `code=${(error as { code?: string }).code}`); }
};
/** Projection-port closed codes surface verbatim (same strings the server returns). */
const throwsPortAsync = async (name: string, fn: () => Promise<unknown>, code: string) => {
  try { await fn(); ok(name, false, "no throw"); }
  catch (error) { ok(name, error instanceof DeviceAiProjectionPortError && error.code === code, `code=${(error as { code?: string }).code}`); }
};

