// ---------------------------------------------------------------------------
// I. Four-domain prepare-body assembly (P1-4c): computeLocalPreview ->
// buildDeviceAiPrepareBody over the SEALED vectors; expected_projection_
// sha256 comes from the on-device recomputation (== sealed canonical sha).
// ---------------------------------------------------------------------------
async function sectionI(): Promise<void> {
  section("I. four-domain prepare body assembly");
  const uuid = "11111111-2222-4333-8444-555555555555";
  const prepareSelectors = (selectors: DeviceAiSelectorWire[]): DeviceAiPrepareSelectorWire[] =>
    selectors as unknown as DeviceAiPrepareSelectorWire[];

  // --- every open domain: preview -> closed body, projection sha == sealed.
  const domainCases = [
    ["empty-tire-single", "single_observation"],
    ["empty-vehicle-complete", "complete_observation"],
    ["empty-formal-recall-nonempty", "complete_formal_observation"],
    ["empty-formal-recall-empty", "complete_formal_observation"],
    ["empty-recall-search-empty", "candidate_page_context"],
  ] as const;
  const singleCase = loadVectorCase("empty-tire-single");
  const singleOrigin = vectorOrigin(singleCase.input);
  const singleSelectors = prepareSelectors(singleCase.input.selectors);
  const singleSummary = await computeLocalPreview(singleCase.bytes, {
    question: QUESTION, selectors: singleSelectors, origin: singleOrigin, projectionMode: "single_observation",
  });
  for (const [name, mode] of domainCases) {
    const domainCase = loadVectorCase(name);
    const origin = vectorOrigin(domainCase.input);
    const selectors = prepareSelectors(domainCase.input.selectors);
    const summary = await computeLocalPreview(domainCase.bytes, {
      question: QUESTION, selectors, origin, projectionMode: mode,
    });
    const body = buildDeviceAiPrepareBody({ origin, preview: summary, selectors, approvedClosure: null, hostReceiptId: uuid, intentId: uuid });
    eq(`I1 ${name} projection_mode echoed`, body.projection_mode, mode);
    eq(`I2 ${name} expected_projection_sha256 == sealed recompute`, body.expected_projection_sha256, domainCase.expectation.canonical_projection!.sha256);
    eq(`I3 ${name} approved_closure null outside closure mode`, body.approved_closure, null);
    eq(`I4 ${name} origin/question echo verbatim`,
      [body.question_sha256, body.package_id, body.expected_sha256, body.expected_byte_count, body.expected_schema, body.expected_owner_scope_id],
      [summary.question_sha256, origin.package_id, origin.expected_sha256, origin.expected_byte_count, origin.package_schema, origin.owner_scope_id]);
    eq(`I5 ${name} selectors carried in request order`, body.selectors.map(item => item.member_key), selectors.map(item => item.member_key));
  }

  // --- frozen_decision_closure: approved closure carried verbatim.
  const closureCase = loadVectorCase("empty-tire-closure");
  const closureOrigin = vectorOrigin(closureCase.input);
  const closureSelectors = prepareSelectors(closureCase.input.selectors);
  const closureSummary = await computeLocalPreview(closureCase.bytes, {
    question: QUESTION, selectors: closureSelectors, origin: closureOrigin,
    projectionMode: "frozen_decision_closure", approvedClosure: closureSelectors,
  });
  const closureBody = buildDeviceAiPrepareBody({
    origin: closureOrigin, preview: closureSummary, selectors: closureSelectors,
    approvedClosure: closureSelectors, hostReceiptId: uuid, intentId: uuid,
  });
  eq("I6 closure approved_closure == resolved closure keys", [...closureBody.approved_closure!].map(item => item.member_key).sort(),
    [...closureSummary.resolved_closure_member_keys].sort());
  eq("I7 closure expected_projection_sha256 == sealed", closureBody.expected_projection_sha256, closureCase.expectation.canonical_projection!.sha256);
  eq("I8 closure body mode", closureBody.projection_mode, "frozen_decision_closure");

  // --- buildDeviceAiPrepareBody fail-closed paths (host fences).
  throwsHost("I9 approved_closure forbidden in single mode", () => buildDeviceAiPrepareBody({
    origin: singleOrigin, preview: singleSummary, selectors: singleSelectors,
    approvedClosure: singleSelectors, hostReceiptId: uuid, intentId: uuid,
  }), "device_ai_host_invalid_argument");
  throwsHost("I10 closure mode requires an approved closure", () => buildDeviceAiPrepareBody({
    origin: closureOrigin, preview: closureSummary, selectors: closureSelectors,
    approvedClosure: null, hostReceiptId: uuid, intentId: uuid,
  }), "device_ai_host_invalid_argument");
  const driftedClosure = [...closureSelectors, { ...closureSelectors[0], member_key: "ee".repeat(32) }] as unknown as DeviceAiPrepareSelectorWire[];
  throwsHost("I11 approved closure drifting from resolved closure rejected", () => buildDeviceAiPrepareBody({
    origin: closureOrigin, preview: closureSummary, selectors: closureSelectors,
    approvedClosure: driftedClosure, hostReceiptId: uuid, intentId: uuid,
  }), "device_ai_host_invalid_argument");
  throwsHost("I12 located-key echo mismatch rejected", () => buildDeviceAiPrepareBody({
    origin: singleOrigin, preview: singleSummary,
    selectors: [{ ...singleSelectors[0], member_key: "ee".repeat(32) }] as unknown as DeviceAiPrepareSelectorWire[],
    approvedClosure: null, hostReceiptId: uuid, intentId: uuid,
  }), "device_ai_host_invalid_argument");
  throwsHost("I13 package echo drift rejected", () => buildDeviceAiPrepareBody({
    origin: { ...singleOrigin, expected_sha256: "ff".repeat(32) }, preview: singleSummary, selectors: singleSelectors,
    approvedClosure: null, hostReceiptId: uuid, intentId: uuid,
  }), "device_ai_host_package_mismatch");

  // --- closed-body semantics mirroring the server DTO validator (P1-4a).
  const validPrepare = {
    package_id: "pkg-1", expected_sha256: "ef".repeat(32), expected_byte_count: 1234,
    expected_schema: "offline-pack@2" as const, expected_owner_scope_id: "9a".repeat(32),
    selectors: [selA], projection_mode: "single_observation" as const, approved_closure: null,
    expected_projection_sha256: "99".repeat(32), question_sha256: "01".repeat(32),
    host_receipt_id: uuid, intent_id: uuid,
  };
  const vehicleSelector: DeviceAiPrepareSelectorWire = {
    kind: "vehicle", member_key: "0a".repeat(32), document_id: null, record_index: null,
    reference: { kind: "vehicle", snapshot_id: "snap-v", verification_id: "ver-v" },
  };
  const vehiclePrepare = {
    ...validPrepare, selectors: [vehicleSelector], projection_mode: "complete_observation" as const,
  };
  assertDeviceAiPrepareBody(vehiclePrepare);
  ok("I14 vehicle-domain body passes the closed assertion", true);
  const recallSearchPrepare = {
    ...validPrepare, selectors: [{
      kind: "recall_search", member_key: "0b".repeat(32), document_id: "doc-rs", record_index: 2,
      reference: { kind: "recall_search", snapshot_id: "snap-rs", verification_id: "ver-rs" },
    } as DeviceAiPrepareSelectorWire], projection_mode: "candidate_page_context" as const,
  };
  assertDeviceAiPrepareBody(recallSearchPrepare);
  ok("I15 recall_search record selector accepted (record-carrying domain)", true);
  throwsHost("I16 test_event selector stays closed (N27)", () => assertDeviceAiPrepareBody({
    ...validPrepare, projection_mode: "complete_event_context" as never,
    selectors: [{ kind: "test_event", member_key: "0c".repeat(32), document_id: null, record_index: null,
      reference: { kind: "test_event", event_id: "evt-1", event_revision: 1 } } as never],
  }), "device_ai_host_invalid_argument");
  throwsHost("I17 complete_event_context is not a prepare mode", () => assertDeviceAiPrepareBody({
    ...validPrepare, projection_mode: "complete_event_context" as never,
  }), "device_ai_host_invalid_argument");
  throwsHost("I18 tire selector with record_index rejected (whole-observation domain)", () => assertDeviceAiPrepareBody({
    ...validPrepare, selectors: [{ ...selA, document_id: "doc-1", record_index: 3 }],
  }), "device_ai_host_invalid_argument");
  throwsHost("I19 vehicle selector with record_index rejected", () => assertDeviceAiPrepareBody({
    ...vehiclePrepare, selectors: [{ ...vehicleSelector, document_id: "doc-v", record_index: 0 }],
  }), "device_ai_host_invalid_argument");
  throwsHost("I20 record_index without document_id rejected (recall)", () => assertDeviceAiPrepareBody({
    ...validPrepare, projection_mode: "complete_formal_observation" as const,
    selectors: [{ kind: "recall", member_key: "0d".repeat(32), document_id: null, record_index: 1,
      reference: { kind: "recall", snapshot_id: "snap-r", recall_revision_id: null, verification_id: "ver-r" } } as DeviceAiPrepareSelectorWire],
  }), "device_ai_host_invalid_argument");
  throwsHost("I21 selector capacity 6 exceeded", () => assertDeviceAiPrepareBody({
    ...validPrepare, selectors: Array.from({ length: 7 }, (_, index) =>
      ({ ...selA, member_key: String(index).repeat(64) })),
  }), "device_ai_host_invalid_argument");
  throwsHost("I22 duplicate member keys rejected", () => assertDeviceAiPrepareBody({
    ...validPrepare, selectors: [selA, { ...selA, reference: selA.reference }],
  }), "device_ai_host_invalid_argument");
  throwsHost("I23 approved_closure capacity 6 exceeded in closure mode", () => assertDeviceAiPrepareBody({
    ...validPrepare, projection_mode: "frozen_decision_closure" as const,
    approved_closure: Array.from({ length: 7 }, (_, index) => ({ ...selA, member_key: String(index).repeat(64) })),
  }), "device_ai_host_invalid_argument");
  throwsHost("I24 approved_closure items carry the same closed selector shape", () => assertDeviceAiPrepareBody({
    ...validPrepare, projection_mode: "frozen_decision_closure" as const,
    approved_closure: [{ ...selA, record_index: 2, document_id: "doc-x" }],
  }), "device_ai_host_invalid_argument");
  throwsHost("I25 per-selector prepare assertion is exported and closed", () =>
    assertDeviceAiPrepareSelector({ ...selA, record_index: 1, document_id: "doc-x" }), "device_ai_host_invalid_argument");
  // M8 (decoder-spec section 3): hash64 negative family — uppercase and
  // wrong-length spellings fail the closed-body assertion like the server 422.
  throwsHost("I26 uppercase hash64 rejected (expected_sha256)", () => assertDeviceAiPrepareBody({
    ...validPrepare, expected_sha256: "EF".repeat(32),
  }), "device_ai_host_invalid_argument");
  throwsHost("I27 short hash64 rejected (selector member_key)", () => assertDeviceAiPrepareBody({
    ...validPrepare, selectors: [{ ...selA, member_key: "a".repeat(63) }],
  }), "device_ai_host_invalid_argument");
  // D5 (decoder-spec 2.6): approved_closure member_key uniqueness at the
  // decoder layer (Rust parity), independent of the builder equality gate.
  throwsHost("I28 approved_closure duplicate member_key rejected", () => assertDeviceAiPrepareBody({
    ...validPrepare, projection_mode: "frozen_decision_closure" as const,
    approved_closure: [selA, { ...selB, member_key: selA.member_key }],
  }), "device_ai_host_invalid_argument");
  // D4 (decoder-spec 4.3-2): expected_byte_count above the 8 MiB package cap
  // (object_store.py MAX_OBJECT_BYTES) now fails the Host assert like the
  // server 422, instead of riding the old 1..2^53-1 slack.
  throwsHost("I29 expected_byte_count above the 8MiB package cap rejected (D4)", () => assertDeviceAiPrepareBody({
    ...validPrepare, expected_byte_count: 8_388_609,
  }), "device_ai_host_invalid_argument");
}

// ---------------------------------------------------------------------------
// H. resolveUnknownOutcome (N18).
// ---------------------------------------------------------------------------
async function sectionH(): Promise<void> {
  section("H. resolveUnknownOutcome lookup-first");
  const client = new DeviceAiHostClient();
  const analysisKey = "12345678-1234-4234-8345-123456789abc";
  let lookupCount = 0;
  let submitCount = 0;
  const restore = setApiTransport(async (path, init) => {
    if (path.startsWith("/v1/ai/analysis-streams/lookup")) { lookupCount++; return new Response(JSON.stringify(streamDetailFixture()), { status: 200 }); }
    if (path === "/v1/ai/analysis-streams" && init.method === "POST") { submitCount++; return new Response("{}", { status: 202 }); }
    return new Response(JSON.stringify({ detail: "unexpected" }), { status: 500 });
  });
  try {
    const resolved = await resolveUnknownOutcome(client, { analysisKey: analysisKey.toUpperCase() });
    ok("H1 hit returns resolved reference", resolved.kind === "resolved" && "detail" in resolved && resolved.detail.analysis.id === "req-1");
    eq("H2 exactly one lookup, zero submits", [lookupCount, submitCount], [1, 0]);
  } finally { restore(); }

  const notFound = setApiTransport(async () => new Response(JSON.stringify({ detail: "未找到" }), { status: 404 }));
  try {
    const noJournal = await resolveUnknownOutcome(client, { analysisKey });
    ok("H3 miss without journal => fresh decision allowed", noJournal.kind === "not_submitted");

    const key = await globalThis.crypto.subtle.generateKey({ name: "AES-GCM", length: 256 }, false, ["encrypt", "decrypt"]);
    const store = new MemoryStore();
    let clock = 0;
    const journal = new DeviceAiJournal({ owner: "profile-1", generation: 1, sessionId: "session-1", key, store, monotonicNow: () => clock += 10 });
    const emptyResult = await resolveUnknownOutcome(client, { analysisKey, journal });
    ok("H4 miss + empty journal => not_submitted", emptyResult.kind === "not_submitted");

    await journal.append({ type: "claim_submitted", intent_id: "intent-1", prepare_id: "prep-1", analysis_key: analysisKey, question_sha256: "bb".repeat(32) });
    const localClaim = await resolveUnknownOutcome(client, { analysisKey, journal, intentId: "intent-1" });
    ok("H5 miss + local claim => same-key-same-body user decision only",
      localClaim.kind === "unknown_local_claim" && localClaim.resubmission === "same_key_same_body_user_decision_only");
    eq("H6 no automatic resubmit happened", submitCount, 0);

    const otherIntent = await resolveUnknownOutcome(client, { analysisKey, journal, intentId: "intent-other" });
    ok("H7 claim filtered by intent id", otherIntent.kind === "not_submitted");

    const nextSession = new DeviceAiJournal({ owner: "profile-1", generation: 1, sessionId: "session-2", key, store, monotonicNow: () => clock += 10 });
    const cross = await resolveUnknownOutcome(client, { analysisKey, journal: nextSession, intentId: "intent-1" });
    ok("H8 cross-session claim never replays (fence 5)", cross.kind === "cross_session_replay_blocked");

    // Tamper the stored blob: integrity failure surfaces without resubmission.
    const { wire, entries } = await unsealForTest(store.blob!, key);
    (entries[0] as { event: { analysis_key: string } }).event.analysis_key = "forged";
    store.blob = await resealForTest(wire, entries, key);
    const integrity = await resolveUnknownOutcome(client, { analysisKey, journal });
    ok("H9 tampered journal => integrity failure surfaced", integrity.kind === "journal_integrity_failed" && integrity.violations.length > 0);
    eq("H10 still zero submits", submitCount, 0);
  } finally { notFound(); }
}

await main();
