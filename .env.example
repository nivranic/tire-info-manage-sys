# API: default is the explicit local SQLite development store at data/dev.db.
# TIRE_DATABASE_URL=postgresql+psycopg://tire:REPLACE_WITH_LOCAL_SECRET@127.0.0.1:5432/tire
TIRE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Comma-separated emergency stop switches; no API keys are needed for Michelin US.
TI_DISABLED_SOURCES=
# Next.js server-side setting; never expose provider credentials as NEXT_PUBLIC_*.
TI_API_BASE_URL=http://127.0.0.1:8000

# Process-local OpenTelemetry and Prometheus: no network exporter or payload capture.
TI_OBSERVABILITY_ENABLED=1
TI_OBSERVABILITY_LOGS=1
# API: GET /v1/observability and /v1/observability/metrics (loopback only).
# Worker metrics require explicit --metrics-port 9465; no listener by default.
# Traces are an in-memory ring, not durable audit/history. No Collector is started.
# OTEL_SDK_DISABLED=true also disables collection and is reflected in status.
# Only valid true/false SDK flags are accepted; remote OTEL endpoints are not used.

# OpenAI Responses: dedicated server environment only, disabled by default.
# Do not put keys in chat, source code, logs, or NEXT_PUBLIC_* settings.
TI_AI_ENABLED=0
# TI_OPENAI_MODEL=YOUR_RESPONSES_MODEL_WITH_STRUCTURED_OUTPUTS
# TI_OPENAI_API_KEY=SET_IN_YOUR_LOCAL_ENVIRONMENT
TI_AI_MAX_OUTPUT_TOKENS=1500
TI_AI_DAILY_TOKEN_LIMIT=100000
TI_AI_DAILY_REQUEST_LIMIT=20
# Public official sources only by default; manual test records are private.
TI_AI_ALLOW_PRIVATE=0
# No ambient OPENAI_API_KEY fallback. These limits are not a dollar billing cap.

# Optional semantic retrieval: PostgreSQL with pgvector is required BEFORE any call.
# Independent from Responses; choose an embedding model that supports dimensions.
# Both use the dedicated TI_OPENAI_API_KEY and share the TI_AI_* daily budget.
TI_EMBEDDINGS_ENABLED=0
# TI_OPENAI_EMBEDDING_MODEL=YOUR_EMBEDDING_MODEL
# TI_OPENAI_EMBEDDING_DIMENSIONS=1536
# Supported dimensions: 1..2000. A model/dimensions change needs a new content cache.
# No automatic indexing: preview selected evidence, then authorize that operation.
# Query embeddings require separate confirmation; ordinary history search is local.

# Executable parser history: API and Worker must share this service-private root.
# Back up it together with the database; source code alone cannot restore old bundles.
# Only current trusted installed Python source may be sealed (no upload/path API).
# TI_PARSER_BUNDLE_ROOT=E:/your-private-data/tire-parser-bundles

# Evidence objects: back up BOTH the database and its object directory/bucket.
# Default: filesystem; SQLite uses <database filename>.objects beside the DB.
# PostgreSQL defaults to data/objects. API and Worker must use the same store.
TI_OBJECT_STORE_BACKEND=filesystem
# TI_OBJECT_STORE_ROOT=E:/your-private-data/tire-objects
# S3-compatible mode requires explicitly configured credentials (server only).
# TI_OBJECT_STORE_BACKEND=s3
# TI_S3_BUCKET=your-evidence-bucket
# TI_S3_ACCESS_KEY_ID=SET_IN_YOUR_LOCAL_ENVIRONMENT
# TI_S3_SECRET_ACCESS_KEY=SET_IN_YOUR_LOCAL_ENVIRONMENT
# TI_S3_ENDPOINT_URL=https://your-s3-compatible-endpoint
# TI_S3_REGION=us-east-1
# R2 typically uses TI_S3_REGION=auto; live S3/R2 acceptance remains pending.
# TI_S3_PREFIX=tire-evidence

# compose requires an externally supplied password. Never commit the real value.
# POSTGRES_PASSWORD=SET_IN_YOUR_LOCAL_ENVIRONMENT
